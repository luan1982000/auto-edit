# Copy to .env (git-ignored). Every value is optional.
# AI translation (Phase 4) uses DeepSeek's OpenAI-compatible API.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

DATA_DIR=./data

# Optional Douyin fallback downloader endpoint (disabled when empty, Phase 2)
DOUYIN_FALLBACK_URL=

# Wall-clock limit for one job, seconds
JOB_TIMEOUT_SEC=900

# Bind address for the API when run with uvicorn directly
BIND_HOST=127.0.0.1
BIND_PORT=8000
